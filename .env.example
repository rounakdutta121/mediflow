# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mediflow?retryWrites=true&w=majority

# Auth.js / NextAuth (required)
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Local only — do NOT set AUTH_URL to localhost on Vercel
AUTH_URL=http://localhost:3000

# Required behind proxies / recommended on Vercel
AUTH_TRUST_HOST=true

# Hospital defaults (used by seed)
SEED_ADMIN_EMAIL=admin@mediflow.local
SEED_ADMIN_PASSWORD=Admin@12345
